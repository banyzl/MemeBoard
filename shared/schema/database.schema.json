{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemeBoard Database v1",
  "type": "object",
  "required": ["schemaVersion", "memes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "memes": { "type": "array", "items": { "$ref": "#/$defs/meme" } }
  },
  "$defs": {
    "meme": {
      "type": "object",
      "required": [
        "id",
        "name",
        "fileName",
        "originalExtension",
        "aliases",
        "tags",
        "triggers",
        "favorite",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fileName": { "type": "string", "pattern": "^[a-fA-F0-9-]+\\.(png|jpe?g|webp|gif)$" },
        "originalExtension": { "enum": ["png", "jpg", "jpeg", "webp", "gif"] },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,63}$" }
        },
        "favorite": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    }
  }
}
